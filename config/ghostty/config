# Ghostty configuration — part of ~/code/dotfiles
# (symlinked to ~/.config/ghostty/config by install.sh)

# --- colours -----------------------------------------------------------------
# Machinist, dark (linked from ~/code/machinist by install.sh), matching the
# prompt and the tmux status bar / pane borders. Background is #211e20 (= tmux
# pane bg), so the window padding below blends into a clean, uniform margin.
theme = machinist

# --- margin / padding --------------------------------------------------------
# tmux cannot inset individual panes, so the "breathing room" comes from padding
# the whole terminal window. window-padding-color = background makes the gap the
# same #211e20 as the panes; balance = true keeps it even on all sides.
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-padding-color = background

# --- quality of life ---------------------------------------------------------
mouse-hide-while-typing = true

# --- Quick Terminal ----------------------------------------------------------
keybind = global:option+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-autohide = true
background-opacity = 0.85
background-blur = true
