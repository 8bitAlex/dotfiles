# Homebrew Bundle — packages installed by `brew bundle` (called from install.sh).
# Regenerate a full snapshot of the current machine with:  brew bundle dump --force

# Shell + prompt
brew "zsh"
brew "starship"        # prompt (config: ~/.config/starship.toml)

# Terminal multiplexer
brew "tmux"            # oh-my-tmux config lives in ~/.config/tmux

# Core tooling
brew "git"
brew "gnupg"           # GPG — required for signed commits (see ~/.gitconfig)

# A Nerd Font so the Starship glyphs + tmux powerline separators render.
# Pick your terminal font to this after install (e.g. "MesloLGS Nerd Font").
cask "font-meslo-lg-nerd-font"
